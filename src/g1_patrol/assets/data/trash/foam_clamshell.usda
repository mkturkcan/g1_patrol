#usda 1.0
(
    defaultPrim = "trash"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "trash" (
    kind = "component"
    prepend apiSchemas = ["PhysicsMassAPI"]
)
{
    float physics:mass = 0.01
    def Mesh "box"
    {
        int[] faceVertexCounts = [3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3]
        int[] faceVertexIndices = [1, 3, 0, 4, 1, 0, 0, 3, 2, 2, 4, 0, 1, 7, 3, 5, 1, 4, 5, 7, 1, 3, 7, 2, 6, 4, 2, 2, 7, 6, 6, 5, 4, 7, 5, 6]
        point3f[] points = [(-0.11500, -0.07500, -0.03250), (-0.10925, -0.07125, 0.03250), (-0.11500, 0.07500, -0.03250), (-0.10925, 0.07125, 0.03250), (0.11500, -0.07500, -0.03250), (0.10925, -0.07125, 0.03250), (0.11500, 0.07500, -0.03250), (0.10925, 0.07125, 0.03250)]
        normal3f[] normals = [(-0.60100, -0.59013, -0.53902), (-0.55149, -0.56314, 0.61540), (-0.60100, 0.59013, -0.53902), (-0.55149, 0.56314, 0.61540), (0.60100, -0.59013, -0.53902), (0.55149, -0.56314, 0.61540), (0.60100, 0.59013, -0.53902), (0.55149, 0.56314, 0.61540)] (
            interpolation = "vertex"
        )
        texCoord2f[] primvars:st = [(0.00000, 0.00000), (0.02500, 0.02500), (0.00000, 1.00000), (0.02500, 0.97500), (1.00000, 0.00000), (0.97500, 0.02500), (1.00000, 1.00000), (0.97500, 0.97500)] (
            interpolation = "vertex"
        )
        uniform token subdivisionScheme = "none"
        rel material:binding = </trash/Looks/foam>
    }
    def Mesh "collision" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]
    )
    {
        uniform token physics:approximation = "convexHull"
        uniform token purpose = "guide"
        int[] faceVertexCounts = [3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3]
        int[] faceVertexIndices = [0, 2, 6, 6, 4, 0, 0, 4, 5, 5, 1, 0, 4, 6, 5, 5, 6, 7, 3, 2, 0, 0, 1, 3, 3, 6, 2, 7, 6, 3, 1, 5, 3, 3, 5, 7]
        point3f[] points = [(-0.11500, -0.07500, -0.03250), (-0.10925, -0.07125, 0.03250), (-0.11500, 0.07500, -0.03250), (-0.10925, 0.07125, 0.03250), (0.11500, -0.07500, -0.03250), (0.10925, -0.07125, 0.03250), (0.11500, 0.07500, -0.03250), (0.10925, 0.07125, 0.03250)]
    }
    def Scope "Looks"
    {
    def Material "foam"
    {
        token outputs:surface.connect = </trash/Looks/foam/shader.outputs:surface>
        def Shader "shader"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.950, 0.950, 0.930)
            float inputs:roughness = 0.7
            float inputs:metallic = 0.0
            float inputs:opacity = 1.0
            token outputs:surface
        }
    }
    }
}
