    def Scope "Looks"
    {
    def Material "green_glass"
    {
        token outputs:surface.connect = </trash/Looks/green_glass/shader.outputs:surface>
        def Shader "shader"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.100, 0.300, 0.120)
            float inputs:roughness = 0.1
            float inputs:metallic = 0.0
            float inputs:opacity = 0.8
            token outputs:surface
        }
    }
    def Material "kraft"
    {
        token outputs:surface.connect = </trash/Looks/kraft/shader.outputs:surface>
        def Shader "shader"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor.connect = </trash/Looks/kraft/tex.outputs:rgb>
            float inputs:roughness = 0.85
            float inputs:metallic = 0.0
            float inputs:opacity = 1.0
            token outputs:surface
        }
        def Shader "tex"
        {
            uniform token info:id = "UsdUVTexture"
            asset inputs:file = @./textures/kraft.png@
            float2 inputs:st.connect = </trash/Looks/kraft/st.outputs:result>
            token inputs:wrapS = "repeat"
            token inputs:wrapT = "clamp"
            float3 outputs:rgb
        }
        def Shader "st"
        {
            uniform token info:id = "UsdPrimvarReader_float2"
            string inputs:varname = "st"
            float2 outputs:result
        }
    }
    }
